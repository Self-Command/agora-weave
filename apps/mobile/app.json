{
  "expo": {
    "name": "AgoraWeave",
    "slug": "agoraweave",
    "scheme": "agoraweave",
    "version": "0.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": { "bundleIdentifier": "org.agoraweave.app", "supportsTablet": true },
    "android": { "package": "org.agoraweave.app", "versionCode": 2026101801 },
    "plugins": ["expo-router", "expo-secure-store", ["expo-image-picker", {
      "photosPermission": "允许 AgoraWeave 选择您要发布的图片",
      "cameraPermission": false,
      "microphonePermission": false
    }]]
  }
}
