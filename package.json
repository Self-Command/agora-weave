{
  "name": "agoraweave",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.23.3", "npm": "10.9.9" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "ci:contracts": "node --experimental-strip-types --test tests/contract/ci/*.spec.ts tests/integration/ci/*.spec.ts tests/security/ci/*.spec.ts",
    "ci:typecheck": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --allowImportingTsExtensions --skipLibCheck tools/ci/*.ts && npm run typecheck --workspaces",
    "ci:build:web": "npm run build --workspace apps/admin && npm run build --workspace apps/share",
    "ci:e2e:web": "playwright test --config tests/e2e/bootstrap/playwright.config.ts",
    "ci:install": "npm ci --no-audit --no-fund",
    "ci:discover": "node --experimental-strip-types tools/ci/discover-targets.ts",
    "ci:run": "node --experimental-strip-types tools/ci/test-harness.ts",
    "ci:tdd": "node --experimental-strip-types tools/ci/tdd-journal.ts",
    "ci:evidence": "node --experimental-strip-types tools/ci/collect-bootstrap.ts",
    "ci:review": "node --experimental-strip-types tools/ci/review-cli.ts",
    "ci:bridge": "node --experimental-strip-types tools/ci/bridge-gate.ts"
  },
  "devDependencies": { "@playwright/test": "1.64.1" }
}
