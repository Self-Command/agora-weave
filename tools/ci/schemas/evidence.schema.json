{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agoraweave.invalid/engineering/evidence-index",
  "title": "Private evidence index",
  "type": "object",
  "required": ["schema_version", "release", "target_sha", "checkout_sha", "run_id", "attempt", "artifacts", "config_digest", "environment", "toolchain_digest", "profile", "check_set_digest", "required_cases", "reports", "tdd_refs", "baseline_refs", "review_refs", "completion_refs", "cleanup"],
  "properties": {
    "schema_version": { "const": 1 },
    "release": { "type": "string", "minLength": 1 },
    "target_sha": { "$ref": "#/$defs/git_sha" },
    "checkout_sha": { "$ref": "#/$defs/git_sha" },
    "run_id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "attempt": { "type": "integer", "minimum": 1 },
    "profile": { "enum": ["bootstrap", "business-increment", "full-release"] },
    "check_set_digest": { "$ref": "#/$defs/digest" },
    "config_digest": { "$ref": "#/$defs/digest" },
    "toolchain_digest": { "$ref": "#/$defs/digest" },
    "environment": { "type": "object", "required": ["source", "runner", "isolation_id"], "properties": { "source": { "const": "github-actions" }, "runner": { "const": "github-hosted" }, "isolation_id": { "type": "string", "minLength": 1 } } },
    "artifacts": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["artifact_id", "raw_report_sha256", "archive_sha256", "retention_class", "retention_days", "private_ref"], "properties": { "artifact_id": { "type": "integer", "minimum": 1 }, "raw_report_sha256": { "$ref": "#/$defs/digest" }, "archive_sha256": { "$ref": "#/$defs/digest" }, "retention_class": { "enum": ["ordinary", "formal", "sensitive"] }, "retention_days": { "type": "integer", "minimum": 1, "maximum": 365 }, "private_ref": { "type": "string", "minLength": 1 } } } },
    "required_cases": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "applicability", "actual_state", "reason", "activation"], "properties": { "id": { "type": "string", "minLength": 1 }, "applicability": { "enum": ["required", "not_yet_applicable", "not_applicable"] }, "actual_state": { "$ref": "#/$defs/actual_state" }, "reason": { "type": "string", "minLength": 1 }, "activation": { "type": "string", "minLength": 1 } } } },
    "reports": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["check_id", "raw_sha256", "state", "private_ref"], "properties": { "check_id": { "type": "string", "minLength": 1 }, "raw_sha256": { "$ref": "#/$defs/digest" }, "state": { "$ref": "#/$defs/actual_state" }, "private_ref": { "type": "string", "minLength": 1 } } } },
    "tdd_refs": { "type": "array", "items": { "type": "string" } },
    "baseline_refs": { "type": "array", "items": { "type": "string" } },
    "review_refs": { "type": "array", "items": { "type": "string" } },
    "completion_refs": { "type": "array", "items": { "type": "string" } },
    "cleanup": { "type": "object", "required": ["state", "failures"], "properties": { "state": { "$ref": "#/$defs/actual_state" }, "failures": { "type": "array", "items": { "type": "string" } } } }
  },
  "$defs": {
    "git_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "actual_state": { "enum": ["passed", "failed", "skipped", "cancelled", "timed_out", "missing", "unavailable", "unknown", "not_executed", "running", "queued"] }
  }
}
